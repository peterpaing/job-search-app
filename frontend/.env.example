# LOCAL DEVELOPMENT EXAMPLE ONLY.
# Public values are visible to the browser; never put secrets in NEXT_PUBLIC_*.

NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
JOBS_API_URL=http://localhost:5000/api/jobs

# Matching Clerk DEVELOPMENT instance used by the backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/profile

NEXT_PUBLIC_SUPPORT_EMAIL=stackwingjobs.support@gmail.com
NEXT_PUBLIC_ACCOUNT_DELETION_ENABLED=false
NEXT_TELEMETRY_DISABLED=1

# Dedicated user in the same Clerk DEVELOPMENT instance.
E2E_CLERK_USER_EMAIL=stackwing-e2e+clerk_test@example.com