# LOCAL DEVELOPMENT EXAMPLE ONLY.
# Replace placeholders in your private .env, never in this committed file.
# Never use production data for integration tests.

NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# Separate development and disposable test destinations.
DATABASE_URL=postgresql://APP_USER:REPLACE_PASSWORD@REPLACE_DEV_HOST/APP_DATABASE?sslmode=require
TEST_DATABASE_URL=postgresql://TEST_USER:REPLACE_PASSWORD@REPLACE_TEST_HOST/TEST_DATABASE?sslmode=require

# Matching Clerk DEVELOPMENT instance used by the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Leave empty locally. Production requires verified trusted proxy CIDRs.
TRUSTED_PROXY_CIDRS=
SHUTDOWN_TIMEOUT_MS=25000

# AI calls disabled by default.
SMARTMATCH_AI_ENABLED=false
OPENAI_API_KEY=
SMARTMATCH_MAX_CONCURRENT=10
SMARTMATCH_USER_DAILY_LIMIT=20
SMARTMATCH_USER_MONTHLY_LIMIT=100
SMARTMATCH_USER_DAILY_TOKEN_LIMIT=50000
SMARTMATCH_USER_MONTHLY_TOKEN_LIMIT=500000
SMARTMATCH_USER_MONTHLY_BUDGET_CENTS=50
SMARTMATCH_DAILY_BUDGET_CENTS=500
SMARTMATCH_MONTHLY_BUDGET_CENTS=15000
SMARTMATCH_MAX_INPUT_TOKENS=24000

# Optional privileged owner identity; leave unset unless intentionally configured.
# SMARTMATCH_OWNER_CLERK_USER_ID=

# Stripe sandbox configuration. Live payments remain disabled.
BILLING_MODE=test
BILLING_LIVE_ENABLED=false
BILLING_AUTOMATIC_TAX=false
BILLING_SANDBOX_CLOCK_ENABLED=false
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PRO_PRICE_ID=price_REPLACE_ME
STRIPE_PORTAL_CONFIGURATION_ID=bpc_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Destructive account-deletion features disabled locally by default.
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_WORKER_ENABLED=false

# Optional: deletion processing may need both keys if a database contains
# billing records from both Stripe modes. Keep these private if configured.
# STRIPE_TEST_SECRET_KEY=
# STRIPE_LIVE_SECRET_KEY=